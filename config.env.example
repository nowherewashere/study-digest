# study settings. Copy to config.env and fill in for yourself; study setup does this.
# Format: KEY=value, no quotes. Lines starting with # are ignored. Tilde is expanded.
#
# EVERYTHING, secrets included, lives in config.env (it is in .gitignore and never goes to
# GitHub; only this example without values does). config.env mode on POSIX is 600.
# The tool manages rutube tokens (refresh/access) itself in .digest/.secrets/ (also outside git).

# --- Moodle
TUIS_URL=https://esystem.rudn.ru
# Token strings (fill in your own values):
TUIS_TOKEN=
GITVERSE_TOKEN=
SOURCECRAFT_TOKEN=
# Rutube (token mode, optional; jwt mode does not use this token):
RUTUBE_TOKEN=
# Deadline window in the digest, days
DIGEST_DAYS=21
# State snapshot between digest runs
DIGEST_STATE=.state.json

# --- Code hosting
# The repository comes from the remote of the current git directory: origin for GitVerse, src for
# SourceCraft, so the same commands work for every course; just run them from the
# directory of the right repository. These values are a fallback when there is no remote.
GV_REPO=
SC_REPO=

# --- Courses
# The digest takes all of the user's courses from TUIS and drops those listed in COURSE_IGNORE.
# Set up by `study courses --setup` (or `study setup`): the ignore list, a local folder name
# per course as lines CODE <Moodle id> <folder name> (empty input means the course id), and the
# submission profile FLOW <id> screencast|direct (required with a folder): screencast = recorded lab,
# course repository per the teacher's rules, git-flow, release with report and slides on both
# hosts, screencasts, answer via `labrelease answer`; direct = answer straight into TUIS as text and/or
# files (`study submit <id> --attach`). The old release|file values are read as synonyms.
DIGEST_ACTIVE_DAYS=60
COURSE_IGNORE=

# Настройки study. Скопировать в config.env и заполнить под себя — это делает setup.sh.
# Формат: КЛЮЧ=значение, без кавычек. Строки с # игнорируются. Тильда разворачивается.
#
# Секретов здесь нет: только пути к файлам с токенами. Сами токены лежат вне
# репозитория, в ~/.config/, с правами 600.

# --- Moodle
TUIS_URL=https://esystem.rudn.ru
TUIS_TOKEN_FILE=~/.config/tuis/token
# Глубина окна дедлайнов в сводке, дней
DIGEST_DAYS=21
# Снимок состояния между запусками сводки
DIGEST_STATE=~/.config/tuis/state.json

# --- Хостинги кода
GITVERSE_TOKEN_FILE=~/.config/gitverse/token
SOURCECRAFT_TOKEN_FILE=~/.config/sourcecraft/token
# Репозиторий по умолчанию. Если пусто — берётся из remote текущего git-каталога:
# origin для GitVerse, src для SourceCraft. Так одни и те же команды работают
# для всех курсов, достаточно запускать их из каталога нужного репозитория.
GV_REPO=
SC_REPO=

# --- Курсы, которые смотрит сводка
# Формат:  COURSE <id в Moodle>  <код каталога рядом с digest/ или ->  <название для сводки>
# Обновлять в начале семестра. Готовые строки по своим курсам печатает команда:
#   digest/study courses
#
# Код каталога «-» означает, что локального каталога у курса нет: он попадёт в сводку
# по срокам, но состояния работ у него не будет.
#
# Если ни одной строки COURSE нет, сводка определит курсы по календарю сама, но менее
# надёжно: курсы, у которых задания скрыты ограничением доступа, в календарь не попадают.

#COURSE 101   subject-one   Название первого курса
#COURSE 102   subject-two   Название второго курса
#COURSE 103   -             Курс без локального каталога
